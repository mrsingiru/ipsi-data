   "words": [
    "접수"
   ],
   "src": "https://www.gwe.go.kr/cmm/fileDown.do?encKey=MTI3MjY5&type=bbs"
  },
  {
   "text": "가. 교부 및 접수 기간 : 2026. 10. 1.(목) ～ 10. 6.(월)",
   "dates": [
    "2026-10-01",
    "2026-10-06"
   ],
   "words": [
    "접수"
